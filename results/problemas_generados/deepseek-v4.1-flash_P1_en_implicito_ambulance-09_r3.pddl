(define (problem ambulance-six-locations)
  (:domain ambulance)
  (:objects
    amb1 amb2 - ambulance
    l1 l2 l3 l4 l5 l6 - location
    p1 p2 p3 p4 - patient
  )
  (:init
    (ambulance-at amb1 l5)
    (ambulance-at amb2 l3)
    (connected l1 l6)
    (connected l6 l1)
    (connected l2 l3)
    (connected l3 l2)
    (connected l2 l4)
    (connected l4 l2)
    (connected l2 l5)
    (connected l5 l2)
    (connected l3 l6)
    (connected l6 l3)
    (connected l4 l6)
    (connected l6 l4)
    (connected l5 l6)
    (connected l6 l5)
    (empty amb1)
    (empty amb2)
    (hospital l4)
    (patient-at p1 l3)
    (patient-at p2 l3)
    (patient-at p3 l5)
    (patient-at p4 l5)
  )
  (:goal (and
    (patient-at p1 l4)
    (patient-at p2 l4)
    (patient-at p3 l4)
    (patient-at p4 l4)
  ))
)

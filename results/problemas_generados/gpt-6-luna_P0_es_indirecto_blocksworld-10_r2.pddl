(define (problem blocks-problem)
  (:domain BLOCKS)
  (:objects
    a b c d e f g h - block
  )
  (:init
    (on a g)
    (on g e)
    (ontable e)
    (clear a)
    (on d h)
    (on h f)
    (ontable f)
    (clear d)
    (ontable b)
    (clear b)
    (ontable c)
    (clear c)
    (handempty)
  )
  (:goal
    (and
      (on d f)
      (on f e)
      (on e h)
      (on h c)
      (on c a)
      (on a g)
      (on g b)
    )
  )
)

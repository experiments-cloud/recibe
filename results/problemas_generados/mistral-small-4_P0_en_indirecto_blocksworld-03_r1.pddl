(define (problem blocks-problem)
  (:domain BLOCKS)
  (:objects a b c d e f - block)
  (:init (ontable a) (ontable b) (ontable c) (ontable d) (ontable e) (ontable f)
         (on a d) (on d b) (on b f) (on f e) (on e c)
         (clear a) (handempty))
  (:goal (and (on e f) (on f a) (on a b) (on b c) (on c d))))

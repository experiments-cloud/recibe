(define (problem ambulance_problem)
  (:domain ambulance)
  (:objects
    l1 l2 l3 l4 l5 l6 l7 - location
    amb1 amb2 - ambulance
    p1 p2 p3 - patient
  )
  (:init
    (connected l3 l6)
    (connected l6 l3)
    (connected l6 l1)
    (connected l1 l6)
    (connected l1 l5)
    (connected l5 l1)
    (connected l5 l2)
    (connected l2 l5)
    (connected l2 l7)
    (connected l7 l2)
    (connected l4 l5)
    (connected l5 l4)
    (hospital l4)
    (ambulance-at amb1 l4)
    (ambulance-at amb2 l6)
    (empty amb1)
    (empty amb2)
    (patient-at p1 l2)
    (patient-at p2 l6)
    (patient-at p3 l1)
  )
  (:goal (and
    (patient-at p1 l4)
    (patient-at p2 l4)
    (patient-at p3 l4)
  ))
)
